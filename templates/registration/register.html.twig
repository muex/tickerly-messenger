{% extends 'base.html.twig' %}

{% block title %}Registrieren{% endblock %}

{% block body %}
    <div class="mx-auto mt-8 max-w-sm rounded-lg bg-white p-6 shadow">
        <h1 class="mb-4 text-center text-xl font-semibold text-slate-800">Registrieren</h1>

        {% for flashError in app.flashes('verify_email_error') %}
            <div class="mb-4 rounded-md bg-red-100 px-4 py-2 text-sm text-red-700" role="alert">{{ flashError }}</div>
        {% endfor %}

        {{ form_start(registrationForm) }}
            <div class="space-y-4">
                {{ form_row(registrationForm.email) }}
                {{ form_row(registrationForm.plainPassword, { label: 'Passwort' }) }}
                {{ form_row(registrationForm.agreeTerms) }}
            </div>
            <button type="submit" class="mt-5 w-full rounded-md bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Registrieren</button>
        {{ form_end(registrationForm) }}
    </div>
{% endblock %}
