{% extends 'auth/base.html.twig' %}

{% block title %}Registrieren{% endblock %}

{% block heading %}Konto erstellen{% endblock %}
{% block subheading %}
    <p class="mt-2 text-sm text-ink-500">Erstelle dein tickerly-Konto in wenigen Sekunden.</p>
{% endblock %}

{% block auth_content %}
    {% for flashError in app.flashes('verify_email_error') %}
        <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600 ring-1 ring-red-100" role="alert">{{ flashError }}</div>
    {% endfor %}

    {{ form_start(registrationForm, { attr: { class: 'space-y-4', novalidate: 'novalidate' } }) }}
        <div>
            <label class="mb-1.5 block text-sm font-medium text-ink-700" for="{{ registrationForm.email.vars.id }}">Email</label>
            {{ form_widget(registrationForm.email, { attr: { class: 'field', placeholder: 'name@beispiel.de', autocomplete: 'email' } }) }}
            {% for e in registrationForm.email.vars.errors %}
                <p class="mt-1.5 text-xs text-red-600">{{ e.message }}</p>
            {% endfor %}
        </div>

        <div>
            <label class="mb-1.5 block text-sm font-medium text-ink-700" for="{{ registrationForm.plainPassword.vars.id }}">Passwort</label>
            {{ form_widget(registrationForm.plainPassword, { attr: { class: 'field', placeholder: '••••••••' } }) }}
            {% for e in registrationForm.plainPassword.vars.errors %}
                <p class="mt-1.5 text-xs text-red-600">{{ e.message }}</p>
            {% endfor %}
        </div>

        <div>
            <label class="flex items-start gap-3 text-sm text-ink-600">
                {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'mt-0.5 h-4 w-4 rounded border-black/20 accent-brand-500' } }) }}
                <span>Ich akzeptiere die Nutzungsbedingungen.</span>
            </label>
            {% for e in registrationForm.agreeTerms.vars.errors %}
                <p class="mt-1.5 text-xs text-red-600">{{ e.message }}</p>
            {% endfor %}
        </div>

        <button type="submit" class="btn-primary mt-2 w-full">Registrieren</button>
    {{ form_end(registrationForm) }}
{% endblock %}

{% block auth_footer %}
    Bereits registriert?
    <a class="font-medium text-brand-500 hover:text-brand-600" href="{{ path('app_login') }}">Anmelden</a>
{% endblock %}
