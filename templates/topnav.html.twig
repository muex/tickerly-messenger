<header class="bg-slate-800 text-white shadow">
    <nav class="mx-auto flex w-full max-w-3xl items-center justify-between px-4 py-3">
        <a class="text-xl font-bold tracking-tight" href="{{ path('app_game_index') }}">
            tickerly
        </a>

        <ul class="flex items-center gap-4 text-sm">
            <li>
                <a class="text-slate-200 hover:text-white" href="{{ path('app_game_index') }}">Startseite</a>
            </li>
            {% if is_granted('ROLE_USER') %}
                <li class="text-slate-400">{{ app.user.email }}</li>
                <li>
                    <a class="text-slate-200 hover:text-white" href="{{ path('app_logout') }}">Abmelden</a>
                </li>
            {% else %}
                <li>
                    <a class="text-slate-200 hover:text-white" href="{{ path('app_login') }}">Anmelden</a>
                </li>
            {% endif %}
        </ul>
    </nav>
</header>
