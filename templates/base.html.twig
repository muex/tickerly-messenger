<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Tickerly{% endblock %}</title>

        {# One canonical per page, built from the matched route so query strings
           and the www host cannot split a page into several addresses. #}
        {% if app.request.attributes.get('_route') %}
            <link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})) }}">
        {% endif %}

        {% block head_meta %}
            <meta name="description" content="Tickerly ist der Live-Ticker für Amateursport: Spielstand und Ereignisse in Sekunden beim Publikum, ganz ohne App.">
        {% endblock %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <!-- Matomo -->
        <script>
          var _paq = window._paq = window._paq || [];
          /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
          _paq.push(["disableCookies"]);
          _paq.push(['trackPageView']);
          _paq.push(['enableLinkTracking']);
          (function() {
            var u="//stat.muex.de/";
            _paq.push(['setTrackerUrl', u+'matomo.php']);
            _paq.push(['setSiteId', '6']);
            var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
            g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
          })();
        </script>
        <!-- End Matomo Code -->

    </head>
    <body class="relative min-h-screen bg-[#f5f5f7] font-sans text-ink-900 antialiased">
        {# Soft ambient colour wash, à la Apple product pages #}
        <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
            <div class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-brand-200/40 blur-3xl"></div>
            <div class="absolute top-1/3 -right-32 h-[28rem] w-[28rem] rounded-full bg-brand-100/50 blur-3xl"></div>
        </div>

        {% block topnav %}
            {% include 'topnav.html.twig' %}
        {% endblock %}
        <main class="mx-auto w-full {% block main_width %}max-w-3xl{% endblock %} px-4 py-10">
            {% block body %}{% endblock %}
        </main>
        {% block scripts %}

        {% endblock %}
    </body>
</html>
