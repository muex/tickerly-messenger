{% extends 'base.html.twig' %}

{% block title %}{{ game.home }} : {{ game.away }}{% endblock %}

{% set is_owner = app.user and app.user.email == game.owner.email %}
{% set is_finished = game.finished %}
{% set share_url = url('app_game_show', {'slug': game.slug}) %}
{% set share_title = game.home ~ ' ' ~ game.homepoints ~ ' : ' ~ game.awaypoints ~ ' ' ~ game.away %}
{% set share_text = game.location ~ ' · ' ~ (game.datetime ? game.datetime|date('d.m.Y H:i') : '') %}

{% block head_meta %}
    <meta name="description" content="{{ share_title }} — {{ share_text }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="tickerly">
    <meta property="og:locale" content="de_DE">
    <meta property="og:url" content="{{ share_url }}">
    <meta property="og:title" content="{{ share_title }}">
    <meta property="og:description" content="{{ share_text }}">

    {% if card_version %}
        {% set card_url = url('app_game_card', {'slug': game.slug}) ~ '?v=' ~ card_version %}
        <meta property="og:image" content="{{ card_url }}">
        <meta property="og:image:type" content="image/png">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Spielstand {{ share_title }}">
        <meta name="twitter:image" content="{{ card_url }}">
    {% endif %}

    <meta name="twitter:card" content="{{ card_version ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ share_title }}">
    <meta name="twitter:description" content="{{ share_text }}">

    {% if not game.active %}
        {# Only owner and admins can see this page at all — keep it out of indexes. #}
        <meta name="robots" content="noindex">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="card mb-6 rounded-3xl p-8 text-center">
        <h1 class="text-lg font-medium text-ink-500" id="matchup">{{ game.home }} : {{ game.away }}</h1>

        <div class="mt-5 flex items-center justify-center gap-5">
            {# The whistle takes the controls away; the voter refuses the routes
               behind them either way. #}
            {% if is_owner and not is_finished %}
                <div class="flex flex-col gap-2">
                    <form method="post" action="{{ path('app_game_increase_home', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-ink-900 text-sm font-semibold text-white transition hover:bg-ink-700 active:scale-95">H+</button>
                    </form>
                    <form method="post" action="{{ path('app_game_decrease_home', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        {# Nothing to take away at nil; the handler clamps too. #}
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-black/5 text-sm font-semibold text-ink-600 transition enabled:hover:bg-black/10 enabled:active:scale-95 disabled:cursor-not-allowed disabled:opacity-40" {% if game.homepoints == 0 %}disabled{% endif %}>H−</button>
                    </form>
                </div>
            {% endif %}
            <span class="text-6xl font-semibold tracking-tight text-ink-900 tabular-nums" id="score">{{ game.homepoints }} : {{ game.awaypoints }}</span>
            {% if is_owner and not is_finished %}
                <div class="flex flex-col gap-2">
                    <form method="post" action="{{ path('app_game_increase_away', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-ink-900 text-sm font-semibold text-white transition hover:bg-ink-700 active:scale-95">A+</button>
                    </form>
                    <form method="post" action="{{ path('app_game_decrease_away', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        {# Nothing to take away at nil; the handler clamps too. #}
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-black/5 text-sm font-semibold text-ink-600 transition enabled:hover:bg-black/10 enabled:active:scale-95 disabled:cursor-not-allowed disabled:opacity-40" {% if game.awaypoints == 0 %}disabled{% endif %}>A−</button>
                    </form>
                </div>
            {% endif %}
        </div>

        <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink-500" id="final" {% if not is_finished %}hidden{% endif %}>Endstand</p>

        <p class="mt-5 text-sm text-ink-400">{{ game.location }}</p>
        <p class="text-sm text-ink-400">{{ game.datetime ? game.datetime|date('d.m.Y H:i') : '' }}</p>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-3">
        {# A plain link to this same page: reloads the score without JavaScript. #}
        <a class="btn-ghost" href="{{ path('app_game_show', {'slug': game.slug}) }}">
            <span aria-hidden="true">↻</span> Aktualisieren
        </a>

        {# Spectators get the score by themselves once a minute, polled from the
           snapshot the projector writes. Not the owner: nothing may rewrite the
           page under someone typing into the event form below. Hidden until the
           script takes over, so nobody is left with a switch that does nothing. #}
        {% if not is_owner and not is_finished %}
            <button class="btn-ghost" type="button" id="autorefresh-toggle" aria-pressed="true" data-snapshot="/games/{{ game.slug }}.json" hidden>
                <span aria-hidden="true">⏱</span> <span id="autorefresh-label">Automatisch aktualisieren</span>
            </button>

            {# What a screen reader hears when the score moves. #}
            <p class="sr-only" id="live-status" role="status" aria-live="polite"></p>
        {% endif %}

        <button class="btn-ghost" id="share-button" data-share-url="{{ share_url }}" data-share-title="{{ share_title }}" data-share-text="{{ share_text }}">
            <span aria-hidden="true">↗</span> <span id="share-label">Teilen</span>
        </button>

        {# Last resort when neither the share sheet nor the clipboard is available. #}
        <input id="share-fallback" class="hidden w-full rounded-full border border-black/10 bg-white px-4 py-2 text-sm text-ink-700 sm:w-80" type="text" readonly value="{{ share_url }}" aria-label="Link zum Spiel">
    </div>

    {% if is_owner and not is_finished %}
        <div class="card mb-6 rounded-3xl p-6">
            {{ render(controller('App\\Controller\\GameCommandController::gameEventForm', {'slug': game.slug})) }}
        </div>
    {% endif %}

    {# Rebuilt from the snapshot as the ticker grows, so it carries no live
       region of its own — re-announcing the whole list every time would drown
       out the one line that is actually new. #}
    <div class="space-y-2" id="events">
        {% for event in game.gameevents %}
            <div class="card flex items-baseline gap-3 rounded-2xl px-5 py-3.5">
                <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-sm font-semibold text-brand-600 tabular-nums">{{ event.timecode }}</span>
                <span class="text-ink-700">{{ event.message }}</span>
            </div>
        {% endfor %}
    </div>

    <div class="mt-8 flex gap-3">
        <a class="btn-ghost" href="{{ path('app_game_index') }}">← Zurück</a>
        {% if is_owner %}
            <a class="btn-ghost" href="{{ path('app_game_edit', {'slug': game.slug}) }}">Bearbeiten</a>

            {# Revocable on purpose: a whistle in the 70th minute must not be the
               end of the ticker. #}
            <form method="post" action="{{ path('app_game_finish', {'slug': game.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('finish') }}">
                <button class="btn-ghost">{{ is_finished ? 'Spiel wieder öffnen' : 'Spiel beenden' }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    <script>
        (function () {
            const button = document.querySelector("#share-button");
            const label = document.querySelector("#share-label");
            const fallback = document.querySelector("#share-fallback");
            const data = {
                title: button.dataset.shareTitle,
                text: button.dataset.shareText,
                url: button.dataset.shareUrl,
            };

            function confirmCopied() {
                label.textContent = "Link kopiert";
                setTimeout(() => { label.textContent = "Teilen"; }, 2000);
            }

            button.addEventListener("click", async () => {
                // On phones this opens the native sheet, WhatsApp and the rest included.
                if (navigator.share) {
                    try {
                        await navigator.share(data);
                        return;
                    } catch (error) {
                        // The user dismissing the sheet is not a failure to fall back from.
                        if (error.name === "AbortError") {
                            return;
                        }
                    }
                }

                try {
                    await navigator.clipboard.writeText(data.url);
                    confirmCopied();
                } catch (error) {
                    // No clipboard permission: show the link so it can be copied by hand.
                    fallback.classList.remove("hidden");
                    fallback.select();
                }
            });
        })();

        (function () {
            const toggle = document.querySelector("#autorefresh-toggle");

            // Absent for the owner, who is the one writing the ticker.
            if (!toggle) {
                return;
            }

            const label = document.querySelector("#autorefresh-label");
            const status = document.querySelector("#live-status");
            const matchup = document.querySelector("#matchup");
            const score = document.querySelector("#score");
            const events = document.querySelector("#events");
            const final = document.querySelector("#final");
            const snapshot = toggle.dataset.snapshot;
            const STORAGE_KEY = "tickerly:autorefresh";
            const INTERVAL = 60000;
            let timer = null;
            let seen = null;
            let current = null;
            let over = false;

            // WCAG 2.2.2 asks for a way to stop this, and the choice has to
            // survive a reload — hence the stored flag.
            function isOn() {
                try {
                    return window.localStorage.getItem(STORAGE_KEY) !== "off";
                } catch (error) {
                    // Storage blocked: refreshing is still the sensible default.
                    return true;
                }
            }

            function remember(value) {
                try {
                    window.localStorage.setItem(STORAGE_KEY, value);
                } catch (error) {
                    // Not storable, but the switch still holds for this page view.
                }
            }

            function busy() {
                const active = document.activeElement;

                // A hidden tab does not need the traffic, and pulling the page
                // out from under someone copying the share link is just rude.
                return document.visibilityState === "hidden"
                    || (active && active.tagName === "INPUT");
            }

            function renderEvents(list) {
                events.replaceChildren(...list.map((event) => {
                    const row = document.createElement("div");
                    row.className = "card flex items-baseline gap-3 rounded-2xl px-5 py-3.5";

                    const timecode = document.createElement("span");
                    timecode.className = "shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-sm font-semibold text-brand-600 tabular-nums";
                    timecode.textContent = event.timecode ?? "";

                    const message = document.createElement("span");
                    message.className = "text-ink-700";
                    message.textContent = event.message ?? "";

                    row.append(timecode, message);

                    return row;
                }));
            }

            function render(game) {
                matchup.textContent = game.home + " : " + game.away;
                score.textContent = game.homepoints + " : " + game.awaypoints;
                renderEvents(game.events);
                final.hidden = !game.finished;

                if (game.finished) {
                    // Nothing will change again. Stop asking, and take away a
                    // switch that now controls nothing.
                    over = true;
                    toggle.hidden = true;
                    window.clearTimeout(timer);
                }
            }

            // Sighted visitors see what moved. This is the same news for
            // everyone else, in one short sentence instead of a whole list.
            function announcement(game, previous) {
                if (!previous) {
                    // The page was already showing this: news to nobody.
                    return "";
                }

                const result = game.home + " " + game.homepoints + ", " + game.away + " " + game.awaypoints + ".";

                if (game.finished && !previous.finished) {
                    return "Spiel beendet. Endstand: " + result;
                }

                if (game.homepoints !== previous.homepoints || game.awaypoints !== previous.awaypoints) {
                    return "Neuer Spielstand: " + result;
                }

                if (game.events.length > previous.events.length) {
                    // Newest first, same order the list is rendered in.
                    const latest = game.events[0];

                    return "Neues Ereignis: " + [latest.timecode, latest.message].filter(Boolean).join(" ");
                }

                return "";
            }

            async function poll() {
                // A static file written by the projector: no PHP runs for a
                // spectator sitting on the page, and an unchanged snapshot is
                // answered with a 304.
                const response = await fetch(snapshot, { cache: "no-cache" });

                if (!response.ok) {
                    throw new Error("Snapshot unavailable: " + response.status);
                }

                const body = await response.text();

                // Nothing happened in the last minute: leave the DOM, and the
                // live region, completely alone.
                if (body === seen) {
                    return;
                }

                seen = body;

                const game = JSON.parse(body);

                render(game);
                status.textContent = announcement(game, current);
                current = game;
            }

            function schedule() {
                window.clearTimeout(timer);
                timer = window.setTimeout(async () => {
                    if (busy()) {
                        schedule();
                        return;
                    }

                    try {
                        await poll();

                        if (!over) {
                            schedule();
                        }
                    } catch (error) {
                        // No snapshot for this game yet, or it stopped being
                        // public: fall back to the plain reload, which renders
                        // from the database and shows whatever the truth is.
                        window.location.reload();
                    }
                }, INTERVAL);
            }

            function apply() {
                const on = isOn();

                toggle.setAttribute("aria-pressed", on ? "true" : "false");
                label.textContent = on ? "Automatisch aktualisieren" : "Automatisch aktualisieren (aus)";

                if (on) {
                    schedule();
                } else {
                    window.clearTimeout(timer);
                }
            }

            toggle.addEventListener("click", () => {
                remember(isOn() ? "off" : "on");
                apply();
            });

            toggle.hidden = false;
            apply();
        })();
    </script>
{% endblock %}
