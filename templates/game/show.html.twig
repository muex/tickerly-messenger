{% extends 'base.html.twig' %}

{% block title %}{{ game.home }} : {{ game.away }}{% endblock %}

{% set is_owner = app.user and app.user.email == game.owner.email %}
{% set share_url = url('app_game_show', {'slug': game.slug}) %}
{% set share_title = game.home ~ ' ' ~ game.homepoints ~ ' : ' ~ game.awaypoints ~ ' ' ~ game.away %}
{% set share_text = game.location ~ ' · ' ~ (game.datetime ? game.datetime|date('d.m.Y H:i') : '') %}

{% block head_meta %}
    <link rel="canonical" href="{{ share_url }}">
    <meta name="description" content="{{ share_title }} — {{ share_text }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="tickerly">
    <meta property="og:locale" content="de_DE">
    <meta property="og:url" content="{{ share_url }}">
    <meta property="og:title" content="{{ share_title }}">
    <meta property="og:description" content="{{ share_text }}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ share_title }}">
    <meta name="twitter:description" content="{{ share_text }}">

    {% if not game.active %}
        {# Only owner and admins can see this page at all — keep it out of indexes. #}
        <meta name="robots" content="noindex">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="card mb-6 rounded-3xl p-8 text-center">
        <h1 class="text-lg font-medium text-ink-500">{{ game.home }} : {{ game.away }}</h1>

        <div class="mt-5 flex items-center justify-center gap-5">
            {% if is_owner %}
                <div class="flex flex-col gap-2">
                    <form method="post" action="{{ path('app_game_increase_home', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-ink-900 text-sm font-semibold text-white transition hover:bg-ink-700 active:scale-95">H+</button>
                    </form>
                    <form method="post" action="{{ path('app_game_decrease_home', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-black/5 text-sm font-semibold text-ink-600 transition hover:bg-black/10 active:scale-95">H−</button>
                    </form>
                </div>
            {% endif %}
            <span class="text-6xl font-semibold tracking-tight text-ink-900 tabular-nums">{{ game.homepoints }} : {{ game.awaypoints }}</span>
            {% if is_owner %}
                <div class="flex flex-col gap-2">
                    <form method="post" action="{{ path('app_game_increase_away', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-ink-900 text-sm font-semibold text-white transition hover:bg-ink-700 active:scale-95">A+</button>
                    </form>
                    <form method="post" action="{{ path('app_game_decrease_away', {'slug': game.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('score') }}">
                        <button class="grid h-9 w-9 place-items-center rounded-full bg-black/5 text-sm font-semibold text-ink-600 transition hover:bg-black/10 active:scale-95">A−</button>
                    </form>
                </div>
            {% endif %}
        </div>

        <p class="mt-5 text-sm text-ink-400">{{ game.location }}</p>
        <p class="text-sm text-ink-400">{{ game.datetime ? game.datetime|date('d.m.Y H:i') : '' }}</p>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-3">
        <button class="btn-ghost" onclick="window.location.reload();">
            <span aria-hidden="true">↻</span> Aktualisieren
        </button>

        <button class="btn-ghost" id="share-button" data-share-url="{{ share_url }}" data-share-title="{{ share_title }}" data-share-text="{{ share_text }}">
            <span aria-hidden="true">↗</span> <span id="share-label">Teilen</span>
        </button>

        {# Last resort when neither the share sheet nor the clipboard is available. #}
        <input id="share-fallback" class="hidden w-full rounded-full border border-black/10 bg-white px-4 py-2 text-sm text-ink-700 sm:w-80" type="text" readonly value="{{ share_url }}" aria-label="Link zum Spiel">
    </div>

    {% if is_owner %}
        <div class="card mb-6 rounded-3xl p-6">
            {{ render(controller('App\\Controller\\GameCommandController::gameEventForm', {'slug': game.slug})) }}
        </div>
    {% endif %}

    <div class="space-y-2">
        {% for event in game.gameevents %}
            <div class="card flex items-baseline gap-3 rounded-2xl px-5 py-3.5">
                <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-sm font-semibold text-brand-600 tabular-nums">{{ event.timecode }}</span>
                <span class="text-ink-700">{{ event.message }}</span>
            </div>
        {% endfor %}
    </div>

    <div class="mt-8 flex gap-3">
        <a class="btn-ghost" href="{{ path('app_game_index') }}">← Zurück</a>
        {% if is_owner %}
            <a class="btn-ghost" href="{{ path('app_game_edit', {'slug': game.slug}) }}">Bearbeiten</a>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    <script>
        (function () {
            const button = document.querySelector("#share-button");
            const label = document.querySelector("#share-label");
            const fallback = document.querySelector("#share-fallback");
            const data = {
                title: button.dataset.shareTitle,
                text: button.dataset.shareText,
                url: button.dataset.shareUrl,
            };

            function confirmCopied() {
                label.textContent = "Link kopiert";
                setTimeout(() => { label.textContent = "Teilen"; }, 2000);
            }

            button.addEventListener("click", async () => {
                // On phones this opens the native sheet, WhatsApp and the rest included.
                if (navigator.share) {
                    try {
                        await navigator.share(data);
                        return;
                    } catch (error) {
                        // The user dismissing the sheet is not a failure to fall back from.
                        if (error.name === "AbortError") {
                            return;
                        }
                    }
                }

                try {
                    await navigator.clipboard.writeText(data.url);
                    confirmCopied();
                } catch (error) {
                    // No clipboard permission: show the link so it can be copied by hand.
                    fallback.classList.remove("hidden");
                    fallback.select();
                }
            });
        })();
    </script>
{% endblock %}
