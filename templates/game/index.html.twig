{% extends 'base.html.twig' %}

{% block title %}Spiele{% endblock %}

{% block body %}
    <h1 class="mb-1 text-center text-3xl font-semibold tracking-tight text-ink-900">Die nächsten Spiele</h1>
    <p class="mb-6 text-center text-sm text-ink-500">Live-Ticker für deine Spiele.</p>

    <div id="next-games" class="space-y-4"></div>

    <h2 class="mb-6 mt-12 text-center text-xl font-semibold tracking-tight text-ink-900">Die letzten Spiele</h2>

    <div id="last-games" class="space-y-4"></div>

    {% if is_granted('ROLE_USER') %}
        <div class="mt-10 text-center">
            <a class="btn-primary" href="{{ path('app_game_new') }}">
                <span class="text-lg leading-none">+</span> Neues Spiel erstellen
            </a>
        </div>
    {% endif %}
{% endblock %}

{% block scripts %}
    <script>
        function renderGames(games) {
            let output = "";
            for (let game of games) {
                let dt = new Date(game.datetime.date);
                output += `
                <a href="/show/${game.id}" class="card block rounded-3xl p-6 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg">
                    <p class="text-base font-medium text-ink-500">${game.home} : ${game.away}</p>
                    <p class="my-2 text-4xl font-semibold tracking-tight text-ink-900">${game.homepoints} : ${game.awaypoints}</p>
                    <p class="text-sm text-ink-400">${game.location}</p>
                    <p class="text-sm text-ink-400">${dt.toLocaleDateString()} ${dt.toLocaleTimeString()}</p>
                    <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-500">Zum Spiel →</span>
                </a>`;
            }
            return output;
        }

        fetch("/nextgames.json")
            .then(response => response.json())
            .then(games => { document.querySelector("#next-games").innerHTML = renderGames(games); });

        fetch("/lastgames.json")
            .then(response => response.json())
            .then(games => { document.querySelector("#last-games").innerHTML = renderGames(games); });
    </script>
{% endblock %}
