{% extends 'base.html.twig' %}

{% block title %}Spiele{% endblock %}

{% block body %}
    <h1 class="mb-1 text-center text-3xl font-semibold tracking-tight text-ink-900">Die nächsten Spiele</h1>
    <p class="mb-6 text-center text-sm text-ink-500">Live-Ticker für deine Spiele.</p>

    <div id="next-games" class="space-y-4"></div>

    <h2 class="mb-6 mt-12 text-center text-xl font-semibold tracking-tight text-ink-900">Die letzten Spiele</h2>

    <div id="last-games" class="space-y-4"></div>

    {% if is_granted('ROLE_USER') %}
        <div class="mt-10 text-center">
            <a class="btn-primary" href="{{ path('app_game_new') }}">
                <span class="text-lg leading-none">+</span> Neues Spiel erstellen
            </a>
        </div>
    {% endif %}
{% endblock %}

{% block scripts %}
    <script>
        function line(cls, text) {
            const p = document.createElement("p");
            p.className = cls;
            p.textContent = text;
            return p;
        }

        function renderGame(game) {
            const dt = new Date(game.datetime.date);

            const card = document.createElement("a");
            card.href = "/games/" + encodeURIComponent(game.slug);
            card.className = "card block rounded-3xl p-6 text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg";

            card.appendChild(line("text-base font-medium text-ink-500", `${game.home} : ${game.away}`));
            card.appendChild(line("my-2 text-4xl font-semibold tracking-tight text-ink-900", `${game.homepoints} : ${game.awaypoints}`));
            card.appendChild(line("text-sm text-ink-400", game.location));
            card.appendChild(line("text-sm text-ink-400", `${dt.toLocaleDateString()} ${dt.toLocaleTimeString()}`));

            const cta = document.createElement("span");
            cta.className = "mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-500";
            cta.textContent = "Zum Spiel →";
            card.appendChild(cta);

            return card;
        }

        function renderGames(target, games) {
            target.replaceChildren(...games.map(renderGame));
        }

        fetch("/nextgames.json")
            .then(response => response.json())
            .then(games => renderGames(document.querySelector("#next-games"), games));

        fetch("/lastgames.json")
            .then(response => response.json())
            .then(games => renderGames(document.querySelector("#last-games"), games));
    </script>
{% endblock %}
