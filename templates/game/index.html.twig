{% extends 'base.html.twig' %}

{% block title %}Spiele{% endblock %}

{% block body %}
    <h1 class="mb-4 text-center text-2xl font-bold text-slate-800">Die nächsten Spiele</h1>

    <div id="next-games" class="space-y-4"></div>

    <h2 class="mb-4 mt-10 text-center text-xl font-semibold text-slate-800">Die letzten Spiele</h2>

    <div id="last-games" class="space-y-4"></div>

    {% if is_granted('ROLE_USER') %}
        <div class="mt-8 text-center">
            <a class="inline-flex items-center justify-center rounded-md bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
               href="{{ path('app_game_new') }}">Neues Spiel erstellen</a>
        </div>
    {% endif %}
{% endblock %}

{% block scripts %}
    <script>
        function renderGames(games) {
            let output = "";
            for (let game of games) {
                let dt = new Date(game.datetime.date);
                output += `
                <div class="rounded-lg bg-white p-5 text-center shadow">
                    <p class="text-lg font-semibold text-slate-800">${game.home} : ${game.away}</p>
                    <p class="my-1 text-2xl font-bold text-slate-900">${game.homepoints} : ${game.awaypoints}</p>
                    <p class="text-sm text-slate-500">${game.location}</p>
                    <p class="text-sm text-slate-500">${dt.toLocaleDateString()} ${dt.toLocaleTimeString()}</p>
                    <a class="mt-3 inline-flex items-center justify-center rounded-md bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800"
                       href="/show/${game.id}">Zum Spiel</a>
                </div>`;
            }
            return output;
        }

        fetch("/nextgames.json")
            .then(response => response.json())
            .then(games => { document.querySelector("#next-games").innerHTML = renderGames(games); });

        fetch("/lastgames.json")
            .then(response => response.json())
            .then(games => { document.querySelector("#last-games").innerHTML = renderGames(games); });
    </script>
{% endblock %}
