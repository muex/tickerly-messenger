{% extends 'admin/_layout.html.twig' %}

{% block title %}Admin – Übersicht{% endblock %}
{% block heading %}Übersicht{% endblock %}

{% block admin_content %}
    <div class="grid gap-4 sm:grid-cols-2">
        {% set cards = [
            { title: 'Nutzer', stats: user_stats, route: 'app_admin_users', link: 'Nutzer verwalten' },
            { title: 'Spiele', stats: game_stats, route: 'app_admin_games', link: 'Spiele verwalten' }
        ] %}
        {% for card in cards %}
            <div class="card rounded-3xl p-6">
                <h2 class="text-lg font-semibold text-ink-900">{{ card.title }}</h2>
                <p class="mt-3 text-5xl font-semibold tracking-tight text-ink-900 tabular-nums">{{ card.stats.total }}</p>
                <div class="mt-4 flex items-center gap-4 text-sm">
                    <span class="inline-flex items-center gap-1.5 text-ink-600">
                        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                        {{ card.stats.active }} aktiv
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-ink-500">
                        <span class="h-1.5 w-1.5 rounded-full bg-ink-400"></span>
                        {{ card.stats.inactive }} inaktiv
                    </span>
                </div>
                <a class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-500" href="{{ path(card.route) }}">
                    {{ card.link }} →
                </a>
            </div>
        {% endfor %}
    </div>

    <h2 class="mt-10 mb-4 text-xl font-semibold tracking-tight text-ink-900">Zuletzt angesetzte Spiele</h2>

    <div class="space-y-2">
        {% for game in latest_games %}
            <div class="card flex flex-wrap items-center justify-between gap-3 rounded-2xl px-5 py-3.5">
                <div>
                    <a class="font-medium text-ink-900 hover:text-brand-500" href="{{ path('app_game_show', {'id': game.id}) }}">
                        {{ game.home }} : {{ game.away }}
                    </a>
                    <p class="text-sm text-ink-400">
                        {{ game.datetime ? game.datetime|date('d.m.Y H:i') : '' }} · {{ game.location }} · {{ game.owner.email }}
                    </p>
                </div>
                {% include 'admin/_status_badge.html.twig' with { active: game.active } only %}
            </div>
        {% else %}
            <p class="text-sm text-ink-500">Noch keine Spiele angelegt.</p>
        {% endfor %}
    </div>
{% endblock %}
